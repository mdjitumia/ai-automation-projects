      "id": "e139c6a0-afa0-4a8f-a7a1-117ac1eb6fbd",
      "name": "Apify - Scrape Product",
      "type": "@apify/n8n-nodes-apify.apify",
      "typeVersion": 1,
      "position": [
        -896,
        -16
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Read Products').item.json;\nconst scraped = $json ?? {};\n\nfunction toNumber(value) {\n  if (typeof value === 'number' && Number.isFinite(value)) return value;\n  if (typeof value !== 'string') return null;\n  const match = value.replace(/,/g, '').match(/-?\\d+(?:\\.\\d+)?/);\n  return match ? Number(match[0]) : null;\n}\n\n// Apify E-commerce Scraping Tool returns offers.price in its normal product-detail output.\nconst rawNewPrice =\n  scraped?.offers?.price ??\n  scraped?.price ??\n  scraped?.product?.price ??\n  scraped?.currentPrice ??\n  scraped?.sellers?.[0]?.price;\n\nconst newPrice = toNumber(rawNewPrice);\nif (newPrice === null) {\n  throw new Error(`No numeric price found for ${source.Product_Name} (${source.Competitor}). Inspect the Apify output.`);\n}\n\nconst oldPrice = toNumber(source.Current_Price);\nconst priceChanged = oldPrice !== null && Math.abs(newPrice - oldPrice) > 0.000001;\nconst delta = oldPrice === null ? null : Number((newPrice - oldPrice).toFixed(2));\nconst pct = oldPrice === null || oldPrice === 0 ? null : Number((((newPrice - oldPrice) / oldPrice) * 100).toFixed(2));\n\nconst now = new Date().toISOString();\n\nreturn {\n  json: {\n    ...source,\n    Current_Price: newPrice,\n    Previous_Price: oldPrice === null ? '' : oldPrice,\n    Price_Change: delta === null ? '' : delta,\n    Last_Checked: now,\n    price_changed: priceChanged,\n    price_change_pct: pct,\n    product_currency: scraped?.offers?.priceCurrency ?? scraped?.currency ?? ''\n  }\n};"
      },
