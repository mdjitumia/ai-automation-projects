    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: `You are a concise e-commerce pricing analyst. Analyze this competitor price change. Product: ${$('Compare Price').item.json.Product_Name}. Competitor: ${$('Compare Price').item.json.Competitor}. Previous price: ${$('Compare Price').item.json.Previous_Price}. Current price: ${$('Compare Price').item.json.Current_Price}. Change: ${$('Compare Price').item.json.Price_Change}. Change percentage: ${$('Compare Price').item.json.price_change_pct}%. State whether the price moved up or down, how significant it is, and one neutral action the business could review. Use only the provided facts. Keep it to 2-3 sentences.` }] }], generationConfig: { maxOutputTokens: 180 } }) }}",
        "options": {}
      },
      "id": "b139a2b6-660c-4245-b941-ab1f3f329fad",
      "name": "Gemini - Analyze Change",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -112,
        128
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "5Pqe6VOTlCkTmZkW",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Compare Price').item.json;\n\n// Extract Gemini response text\nconst insight = (\n  $json?.candidates?.[0]?.content?.parts ?? []\n)\n  .map(part => part.text || '')\n  .join('')\n  .trim();\n\n// Calculate direction\nconst change = Number(src.Price_Change);\n\nconst direction =\n  change < 0\n    ? 'DECREASED'\n    : change > 0\n    ? 'INCREASED'\n    : 'UNCHANGED';\n\n// Percentage text\nconst percentage =\n  src.price_change_pct !== null &&\n  src.price_change_pct !== undefined &&\n  src.price_change_pct !== ''\n    ? ` (${src.price_change_pct > 0 ? '+' : ''}${src.price_change_pct}%)`\n    : '';\n\n// Currency\nconst currency = src.product_currency || 'USD';\n\n// Final Telegram message\nconst telegramMessage =\n`🚨 Competitor Price Alert\n\nProduct: ${src.Product_Name}\nCompetitor: ${src.Competitor}\n\nPrevious Price: ${src.Previous_Price} ${currency}\nCurrent Price: ${src.Current_Price} ${currency}\n\nPrice Change: ${change > 0 ? '+' : ''}${change} ${currency}${percentage}\nMovement: ${direction}\n\nAI Insight:\n${insight || 'The competitor price has changed. Please review the current market price.'}\n\nProduct URL:\n${src.Product_URL}`;\n\n// IMPORTANT:\n// Run Once for Each Item → return ONE object, not an array.\nreturn {\n  json: {\n    ...src,\n    telegramMessage\n  }\n};"
      },
